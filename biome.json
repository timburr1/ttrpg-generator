{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false, "includes": ["src/**", "*.json", "!package-lock.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useBlockStatements": "error" },
      "nursery": { "noFloatingPromises": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
